.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 编辑卡片 */
.edit-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.edit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
}

.type-tag {
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.3);
}

.type-tag.expense {
  background: rgba(245, 108, 108, 0.8);
}

.amount-display {
  display: flex;
  align-items: center;
}

.amount-sign {
  font-size: 36rpx;
  color: #fff;
}

.amount-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.edit-body {
  padding: 30rpx;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.form-label {
  width: 100rpx;
  font-size: 30rpx;
  color: #333;
}

.form-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 30rpx;
}

.row-value {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.voice-tag {
  color: #07c160;
  font-size: 26rpx;
}

/* 类型选择器 */
.type-selector {
  display: flex;
  gap: 20rpx;
}

.type-option {
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  background: #f0f0f0;
  color: #666;
}

.type-option.active {
  background: #07c160;
  color: #fff;
}

/* 分类选择器 */
.form-picker {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  padding: 30rpx;
  gap: 30rpx;
}

.save-btn {
  flex: 1;
  height: 80rpx;
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 30rpx;
}

.delete-btn {
  flex: 1;
  height: 80rpx;
  background: #f56c6c;
  color: #fff;
  border-radius: 8rpx;
  font-size: 30rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300rpx;
  color: #999;
}