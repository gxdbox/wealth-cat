.container {
  padding: 0;
  padding-bottom: 120rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.record-list {
  padding: 0 30rpx;
}

/* 日期分组 */
.date-group {
  margin-bottom: 40rpx;
}

.date-header {
  display: flex;
  align-items: baseline;
  padding: 30rpx 0 20rpx;
}

.date-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}

.date-week {
  font-size: 24rpx;
  color: #999;
}

/* 账单卡片 */
.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e5e5e5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-item:active {
  opacity: 0.7;
}

/* 图标 */
.record-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 信息区 */
.record-info {
  flex: 1;
  min-width: 0;
}

.record-category {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.record-note {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  font-size: 22rpx;
  color: #666;
}

/* 金额 */
.record-amount {
  font-size: 32rpx;
  font-weight: bold;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.record-amount.expense {
  color: #07c160;
}

.record-amount.income {
  color: #07c160;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-btn {
  background: #07c160;
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}

/* 浮动按钮 */
.floating-btn {
  position: fixed;
  right: 40rpx;
  bottom: 100rpx;
  width: 100rpx;
  height: 100rpx;
  background: #07c160;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.4);
}
