<view class="container">
  <!-- 账单列表 -->
  <view class="record-list">
    <!-- 今天的账单 -->
    <view wx:if="{{todayRecords.length > 0}}" class="date-group">
      <view class="date-header">
        <text class="date-title">今天</text>
        <text class="date-week">{{todayWeek}}</text>
      </view>
      <view wx:for="{{todayRecords}}" wx:key="_id" class="record-item"
            data-id="{{item._id}}" bindtap="onRecordTap">
        <view class="record-icon-wrap" style="background: {{item.iconBg}}">
          <image class="record-icon" src="{{item.iconUrl}}" mode="aspectFit"></image>
        </view>
        <view class="record-info">
          <view class="record-category">{{item.categoryName}}</view>
          <view wx:if="{{item.note}}" class="record-note">{{item.note}}</view>
          <view class="record-meta">
            <text>{{item.time}}</text>
            <text wx:if="{{item.account}}"> · {{item.account}}</text>
            <text wx:if="{{item.member}}"> · {{item.member}}</text>
          </view>
        </view>
        <view class="record-amount {{item.type === 'income' ? 'income' : 'expense'}}">
          {{item.type === 'expense' ? '-' : '+'}}{{item.amountDisplay}}
        </view>
      </view>
    </view>

    <!-- 今天以前的账单 -->
    <view wx:if="{{pastRecords.length > 0}}" class="date-group">
      <view class="date-header">
        <text class="date-title">今天以前</text>
      </view>
      <view wx:for="{{pastRecords}}" wx:key="_id" class="record-item"
            data-id="{{item._id}}" bindtap="onRecordTap">
        <view class="record-icon-wrap" style="background: {{item.iconBg}}">
          <image class="record-icon" src="{{item.iconUrl}}" mode="aspectFit"></image>
        </view>
        <view class="record-info">
          <view class="record-category">{{item.categoryName}}</view>
          <view wx:if="{{item.note}}" class="record-note">{{item.note}}</view>
          <view class="record-meta">
            <text>{{item.time}}</text>
            <text wx:if="{{item.account}}"> · {{item.account}}</text>
            <text wx:if="{{item.member}}"> · {{item.member}}</text>
          </view>
        </view>
        <view class="record-amount {{item.type === 'income' ? 'income' : 'expense'}}">
          {{item.type === 'expense' ? '-' : '+'}}{{item.amountDisplay}}
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{todayRecords.length === 0 && pastRecords.length === 0}}" class="empty-state">
      <text class="empty-icon">📝</text>
      <text class="empty-text">还没有账单记录</text>
      <button class="empty-btn" bindtap="goVoiceRecord">去记账</button>
    </view>
  </view>
</view>

<view class="floating-btn" bindtap="goVoiceRecord">+</view>
